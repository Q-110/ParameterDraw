{
  "name": "parameter-draw-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "web:dev": "vite --host 127.0.0.1",
    "build": "vue-tsc -b && vite build",
    "backend:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-python-backend.ps1",
    "preview": "vite preview --host 127.0.0.1",
    "dist": "pnpm backend:build && pnpm build && electron-builder --win nsis portable",
    "dist:portable": "pnpm backend:build && pnpm build && electron-builder --win portable",
    "dist:installer": "pnpm backend:build && pnpm build && electron-builder --win nsis"
  },
  "build": {
    "appId": "com.parameterdraw.desktop",
    "productName": "ParameterDraw",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.ico",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../code",
        "to": "code",
        "filter": [
          "**/*",
          "!**/.git/**",
          "!**/.idea/**",
          "!**/.opencode/**",
          "!**/.venv/**",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!requirements.txt"
        ]
      },
      {
        "from": "build/python-backend/run_from_json",
        "to": "backend/run_from_json",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "element-plus": "^2.14.1",
    "three": "^0.184.0",
    "vue": "^3.5.34"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "less": "^4.6.4",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8",
    "wait-on": "^9.0.10"
  }
}
